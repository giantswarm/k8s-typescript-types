{
  // Consumer smoke: type-checks src/smoke/ against the built dist/
  // declarations, resolved the way a consumer of the package resolves them:
  // `@giantswarm/k8s-types` and its subpaths resolve through the package's own
  // `exports` map (a self-reference). Run by `yarn smoke` (and therefore
  // `yarn build`) after `tsc` has produced dist/. Nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./src"
  },
  "include": ["src/smoke"]
}
