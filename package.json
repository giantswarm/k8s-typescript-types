{
  "name": "@giantswarm/k8s-types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for Kubernetes core objects and custom resource definitions",
  "main": "dist/types/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./crds": {
      "types": "./dist/types/crds/index.d.ts",
      "default": "./dist/types/crds/index.js"
    },
    "./crds/*": {
      "types": "./dist/types/crds/*/index.d.ts",
      "default": "./dist/types/crds/*/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/types/core/index.js"
    },
    "./core/*": {
      "types": "./dist/types/core/*/index.d.ts",
      "default": "./dist/types/core/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "author": "Giant Swarm",
  "keywords": [
    "kubernetes",
    "k8s",
    "typescript",
    "types"
  ],
  "scripts": {
    "generate": "tsx src/generator/index.ts",
    "build": "tsc && yarn smoke",
    "smoke": "tsc -p tsconfig.smoke.json",
    "clean": "rm -rf dist src/types/crds/*",
    "regenerate": "yarn clean && yarn generate && yarn build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/js-yaml": "^4",
    "@types/lodash": "^4.17.5",
    "@types/node": "^24.9.1",
    "js-yaml": "^5.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "lodash": "^4.17.21",
    "node-fetch": "^3",
    "tsx": "^4.22.4",
    "typescript": "~7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
